// Firestore checks these rules on the server for every database request.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Only signed-in accounts can use the app's protected data.
    function signedIn() {
      return request.auth != null;
    }

    // Build the path to a user's role document.
    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // Check the saved role and make sure the account is still active.
    function hasRole(uid, expectedRole) {
      return exists(userPath(uid))
        && get(userPath(uid)).data.role == expectedRole
        && get(userPath(uid)).data.active != false;
    }

    // These helpers keep role checks short and reusable below.
    function isManager() {
      return signedIn() && hasRole(request.auth.uid, 'manager');
    }

    function isRanger() {
      return signedIn() && hasRole(request.auth.uid, 'ranger');
    }

    // Build the path to one incident document.
    function incidentPath(incidentId) {
      return /databases/$(database)/documents/incidents/$(incidentId);
    }

    function patrolAssignmentPath(patrolId) {
      return /databases/$(database)/documents/patrolAssignments/$(patrolId);
    }

    function isAssignedPatrolRanger(patrolId) {
      return isRanger()
        && exists(patrolAssignmentPath(patrolId))
        && get(patrolAssignmentPath(patrolId)).data.assignedRangerId
             == request.auth.uid;
    }

    // The ranger who submitted a report may access their own incident.
    function isReporter(incidentId) {
      return isRanger()
        && exists(incidentPath(incidentId))
        && get(incidentPath(incidentId)).data.rangerId == request.auth.uid;
    }

    // A ranger assigned by a manager may access that incident.
    function isAssignedResponder(incidentId) {
      return isRanger()
        && exists(incidentPath(incidentId))
        && request.auth.uid in get(incidentPath(incidentId)).data.assignedRangerIds;
    }

    // Managers, the reporter, and assigned responders can read an incident.
    function canReadIncident(incidentId) {
      return isManager() || isReporter(incidentId) || isAssignedResponder(incidentId);
    }

    // Use the incident document being authorized directly for collection
    // queries. Firestore must be able to prove that every query result is
    // readable; re-reading the same incident with get() can make an otherwise
    // properly constrained arrayContains query fail authorization.
    function canReadIncidentDocument(data) {
      return isManager()
        || (isRanger() && data.rangerId == request.auth.uid)
        || (isRanger() && request.auth.uid in data.assignedRangerIds);
    }

    // User profiles hold roles; ordinary users cannot make themselves managers.
    match /users/{userId} {
      // A user may read their own role; managers can list ranger profiles to assign.
      allow get: if signedIn() && (request.auth.uid == userId || isManager());
      allow list: if isManager();

      // New accounts can only provision themselves as ordinary rangers.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role == 'ranger'
        && request.resource.data.active == true;

      // Users cannot promote themselves, deactivate themselves, or edit history.
      allow update: if signedIn()
        && request.auth.uid == userId
        && resource.data.role == 'ranger'
        && request.resource.data.role == resource.data.role
        && request.resource.data.active == resource.data.active
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName']);
      allow delete: if false;
    }

    // Incident access is limited to its reporter, assigned responders, or managers.
    match /patrolAssignments/{patrolId} {
      allow get, list: if isManager()
        || (isRanger() && resource.data.assignedRangerId == request.auth.uid);
      allow create: if isManager()
        && request.resource.data.assignedRangerId is string
        && exists(userPath(request.resource.data.assignedRangerId))
        && get(userPath(request.resource.data.assignedRangerId)).data.role == 'ranger'
        && get(userPath(request.resource.data.assignedRangerId)).data.active != false
        && request.resource.data.parkName is string
        && request.resource.data.zoneName is string
        && request.resource.data.routeName is string
        && (
          !('centerLatitude' in request.resource.data)
          && !('centerLongitude' in request.resource.data)
          || (
            request.resource.data.centerLatitude is number
            && request.resource.data.centerLongitude is number
            && request.resource.data.centerLatitude >= -90
            && request.resource.data.centerLatitude <= 90
            && request.resource.data.centerLongitude >= -180
            && request.resource.data.centerLongitude <= 180
          )
        );
      allow update: if isManager()
        && request.resource.data.assignedRangerId is string
        && exists(userPath(request.resource.data.assignedRangerId))
        && get(userPath(request.resource.data.assignedRangerId)).data.role == 'ranger'
        && get(userPath(request.resource.data.assignedRangerId)).data.active != false
        && !exists(
          /databases/$(database)/documents/patrols/$(patrolId)
        );
      allow delete: if isManager()
        && !exists(
          /databases/$(database)/documents/patrols/$(patrolId)
        );
    }

    match /patrols/{patrolId} {
      allow get, list: if isManager()
        || (isRanger() && resource.data.rangerId == request.auth.uid);

      // Patrol documents are created only at final synchronization. The
      // assignment remains the authorization source; clients cannot create
      // or rewrite assignments through this session collection.
      allow create: if isAssignedPatrolRanger(patrolId)
        && request.resource.data.patrolId == patrolId
        && request.resource.data.rangerId == request.auth.uid
        && request.resource.data.status == 'completedPendingSync';

      allow update: if (
        isAssignedPatrolRanger(patrolId)
        && resource.data.rangerId == request.auth.uid
        && resource.data.status == 'completedPendingSync'
        && request.resource.data.status == 'completedSynced'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'lastSyncedAt'])
      ) || (
          isManager()
          && resource.data.status == 'completedSynced'
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'managerReviewStatus', 'reviewedAt', 'reviewedBy',
                 'managerNotes', 'followUpRequired'
               ])
          && request.resource.data.managerReviewStatus in [
               'reviewed', 'followUpRequired'
             ]
          && request.resource.data.followUpRequired is bool
          && request.resource.data.managerNotes is string
          && request.resource.data.reviewedBy == request.auth.uid
          && (
            !('reviewedAt' in request.resource.data)
            || request.resource.data.reviewedAt is timestamp
          )
          && (
            request.resource.data.managerReviewStatus != 'reviewed'
            || (
              'reviewedAt' in request.resource.data
              && request.resource.data.reviewedAt is timestamp
            )
          )
        );
      allow delete: if false;

      match /{recordCollection}/{recordId} {
        allow get, list: if recordCollection in [
            'routePoints', 'manualWaypoints', 'observations',
            'photographs', 'pauseResumeEvents'
          ] && (isManager()
          || (isAssignedPatrolRanger(patrolId)
              && get(
                /databases/$(database)/documents/patrols/$(patrolId)
              ).data.rangerId == request.auth.uid));
        allow create: if recordCollection in [
            'routePoints', 'manualWaypoints', 'observations',
            'photographs', 'pauseResumeEvents'
          ] && isAssignedPatrolRanger(patrolId)
          && request.resource.data.id == recordId
          && getAfter(
            /databases/$(database)/documents/patrols/$(patrolId)
          ).data.rangerId == request.auth.uid;
        allow update: if recordCollection in [
            'routePoints', 'manualWaypoints', 'observations',
            'photographs', 'pauseResumeEvents'
          ] && isAssignedPatrolRanger(patrolId)
          && request.resource.data == resource.data;
        allow delete: if false;
      }
    }
    match /incidents/{incidentId} {
      allow create: if isRanger()
        && request.resource.data.rangerId == request.auth.uid
        && request.resource.data.status == 'Uploading';

      allow get, list: if canReadIncidentDocument(resource.data);

      // Reporter sync is limited to completing its own Uploading record.
      allow update: if (
          isReporter(incidentId)
          && resource.data.status == 'Uploading'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'submittedAt', 'updatedAt'])
        ) || (
          isManager()
          && request.resource.data.workflowStatus in [
               'reported', 'underReview', 'assigned', 'responseInProgress',
               'resolved', 'followUpRequired', 'monitoring', 'closed',
               'duplicate', 'rejected'
             ]
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly([
                 'severity', 'activeThreat', 'workflowStatus',
                 'assignmentType', 'assignedRangerIds', 'assignedRangerNames',
                 'assignedAt', 'assignedBy', 'managerNote', 'followUpReason',
                 'escalationReason', 'closedAt', 'closedBy', 'updatedAt'
               ])
        ) || (
          isAssignedResponder(incidentId)
          && resource.data.workflowStatus
               in ['assigned', 'responseInProgress', 'followUpRequired', 'monitoring']
          && request.resource.data.workflowStatus
               in ['responseInProgress', 'resolved']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['workflowStatus', 'updatedAt'])
          && request.resource.data.workflowStatus
               in ['responseInProgress', 'resolved']
        );
      allow delete: if false;

      // Original report photos are added by the reporter during upload.
      match /evidence/{evidenceId} {
        allow get, list: if canReadIncident(incidentId);
        allow create, update: if isReporter(incidentId)
          && get(incidentPath(incidentId)).data.status == 'Uploading';
        allow delete: if false;
      }

      // Each response belongs to an assigned ranger and cannot be edited later.
      match /responses/{responseId} {
        allow get, list: if canReadIncident(incidentId);
        allow create: if isAssignedResponder(incidentId)
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.status
               in ['responseInProgress', 'resolved'];
        allow update, delete: if false;

        // Extra response photos must be saved with their response record.
        match /evidence/{evidenceId} {
          allow get, list: if canReadIncident(incidentId);
          allow create: if isAssignedResponder(incidentId)
            && getAfter(/databases/$(database)/documents/incidents/$(incidentId)/responses/$(responseId))
                 .data.actorId == request.auth.uid;
          allow update, delete: if false;
        }
      }

      // Keep a readable audit trail of manager, ranger, and responder actions.
      match /timeline/{eventId} {
        allow get, list: if canReadIncident(incidentId);
        allow create: if (
            (isManager() || isAssignedResponder(incidentId))
            && request.resource.data.actorId == request.auth.uid
          ) || (
            isReporter(incidentId)
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.type == 'reportSubmitted'
          );
        // The initial event has a stable payload so retrying report sync is safe.
        allow update: if isReporter(incidentId)
          && resource.data.type == 'reportSubmitted'
          && request.resource.data == resource.data;
        allow delete: if false;
      }
    }
  }
}
